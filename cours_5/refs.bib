@article{nezamiNetworkCentralityFirm2025,
  title = {Network Centrality and Firm Performance: {{A}} Meta-Analysis},
  shorttitle = {Network Centrality and Firm Performance},
  author = {Nezami, Mehdi and Chisam, Natalie and Palmatier, Robert W.},
  date = {2025-01},
  journaltitle = {Journal of the Academy of Marketing Science},
